# Set these in the Vercel dashboard (Project → Settings → Environment Variables).
# Do NOT commit a real .env file.

# Required: your Telegram bot token from @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# Optional: a random string Telegram must echo back on every webhook call.
# If set here, also pass it when registering the webhook (see README).
WEBHOOK_SECRET=

# Optional: any random string; strengthens the per-user mailbox password.
MAIL_SALT=
